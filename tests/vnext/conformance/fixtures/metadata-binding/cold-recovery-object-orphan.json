      {"op": "remove", "path": "/parts/~1docstyle~1catalogue.json/json/objects/tbl-outcomes"},
      {
        "op": "add",
        "path": "/parts/~1docstyle~1catalogue.json/json/objects/tbl-orphan",
        "value": {
          "id": "tbl-orphan",
          "type": "table",
          "semantics": {
            "label": "Table 1",
            "caption": "g-caption-x2r9qa",
            "summary": "Outcomes by arm",
            "notes": ["g-paragraph-n4t8qa"]
          }
        }
      }
    ]
  },
  "expect": {"ok": false, "errors": ["object-region-missing"], "where": ["tbl-orphan"]}
